     case 1: printf("read the no of elements:");
             scanf("%d",&n);
             printf("read the elments");
             for(i=1;i<=n;i++)
                scanf("%d",&a[i]);
             heapify(a,n);
             printf("\nelements after constructing heap :\n");
              for(i=1;i<=n;i++)
               printf("%d",a[i]);
               break;
     case 2:
        if(n>=1){
            printf("element deleted is %d",a[1]);
            a[1]=a[n];
            n=n-1;
            heapify(a,n);
            printf("\nheap afer deletion is:");
            for(i=1;i<=n;i++)
               printf("%d",a[i]);
        }
        else{
            printf("\n no elements to delete");

        }
        break;
    default: exit(0);

}
}
return 0;
}
