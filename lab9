#include <stdio.h>
#include <stdlib.h>
void heapify(int a[10],int n){
 int i,k,v,j,flag=0;
 for(i=n/2;i>=1;i--){
    k=i;
    v=a[k];
    while(!flag&&2*k<=n){
        j=2*k;
        if(j<n){
         if(a[j]<a[j+1])
           j=j+1;
    }
    if(v>a[j])
       flag=1;
    else{
        a[k]=a[j];
        k=j;
    }
}
  a[k]=v;
  flag=0;
 }
}
int main()
{ int n,a[10],i,choice;
for(;;){
    printf("\n1. create heap \n 2.extraxct heap \n 3.exit \n read choice :");
    scanf("%d",&choice);
